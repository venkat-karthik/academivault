# ==============================================================
# ACADEMIAVAULT - PRODUCTION ENVIRONMENT CONFIGURATION (VERCEL)
# ==============================================================

# 1. CORE APPLICATION ENVIRONMENT
PORT=3000
NODE_ENV=production
APP_URL="https://your-academivault.vercel.app"

# 2. GOOGLE CLOUD FIRESTORE PERSISTENCE
# Generate Service Account JSON from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 3. CLOUDINARY AUTHENTICATED ASSET STORAGE
# Cloudinary Dashboard -> Settings -> Access Keys
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# 4. RAZORPAY PAYMENT GATEWAY
# Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_live_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_live_razorpay_webhook_secret"

# 5. GOOGLE GEMINI AI ENGINE
# Google AI Studio -> Get API Key
GEMINI_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# 6. SESSION & TOKEN SECURITY
SESSION_SECRET="generate_a_random_64_character_hex_string_for_session_token_signing"
DRM_PAGE_TOKEN_EXPIRY_SECONDS=180
ENFORCE_SINGLE_DEVICE=true

